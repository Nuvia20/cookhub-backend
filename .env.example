PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# Local PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-local-password
DB_NAME=cookhub
DB_CONNECTION_LIMIT=10

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Render PostgreSQL can provide DATABASE_URL instead of the variables above.
# DATABASE_URL=postgresql://user:password@host:5432/database